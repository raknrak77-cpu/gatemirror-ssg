/* =====================================================
   GATEMIRROR - MASTER CSS (GÖMÜLÜ)
   Tüm template'ler (home, list, single, all-articles, about, contact, privacy)
   Aynı bu CSS'i kullanır. style.css bağımlılığı YOK.
   ===================================================== */

/* ===================== */
/* GLOBAL RESET & ROOT */
/* ===================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #2ecc71;
    --primary-dark: #1a8c3f;
    --primary-light: #5ee0a0;
    --dark: #0a0a0a;
    --text: #1a1a1a;
    --text-light: #666;
    --text-muted: #888;
    --gray: #f5f5f5;
    --white: #ffffff;
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    --shadow-hover: 0 20px 40px rgba(0, 0, 0, 0.1);
    --border-radius: 1rem;
    --transition: all 0.3s ease;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text);
    background: var(--white);
    line-height: 1.6;
    overflow-x: hidden;
}

/* ===================== */
/* TYPOGRAPHY */
/* ===================== */
h1, h2, h3, h4, h5, h6 {
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em;
}

h1 { font-size: 2.5rem; margin-bottom: 1rem; }
h2 { font-size: 1.8rem; margin-bottom: 0.75rem; }
h3 { font-size: 1.4rem; margin-bottom: 0.5rem; }

a {
    text-decoration: none;
    color: inherit;
    transition: var(--transition);
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

/* ===================== */
/* BUTTONS - GRADIENT */
/* ===================== */
.btn, .cat-btn, .archive-btn, .random-btn {
    display: inline-block;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 2rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: var(--transition);
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(46, 204, 113, 0.3);
}

.btn:hover, .cat-btn:hover, .archive-btn:hover, .random-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(46, 204, 113, 0.4);
}

.btn-secondary {
    background: transparent;
    border: 2px solid var(--primary);
    color: var(--primary);
    box-shadow: none;
}

.btn-secondary:hover {
    background: var(--primary);
    color: white;
}

.category-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 2rem 0;
}

/* ===================== */
/* HEADER & NAVIGATION */
/* ===================== */
nav {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    padding: 1rem 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
}

.logo {
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--dark);
    letter-spacing: -0.5px;
}

.logo span {
    color: var(--primary-dark);
}

.nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
}

.nav-links a {
    font-weight: 500;
}

.nav-links a:hover {
    color: var(--primary);
}

.menu-btn {
    display: none;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--dark);
}

/* ===================== */
/* SIDE MENU (MOBILE) */
/* ===================== */
.side-menu {
    position: fixed;
    top: 0;
    left: -100%;
    width: 80%;
    max-width: 300px;
    height: 100%;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(12px);
    color: white;
    transition: left 0.3s ease-in-out;
    z-index: 2000;
    padding: 2rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.side-menu.active {
    left: 0;
}

.close-menu {
    text-align: right;
    font-size: 1.5rem;
    cursor: pointer;
    color: #aaa;
}

.close-menu:hover {
    color: white;
}

.side-menu .nav-links {
    display: flex;
    flex-direction: column;
    gap: 0;
}

.side-menu .nav-links a {
    display: block;
    padding: 0.8rem 0;
    border-bottom: 1px solid #444;
    color: white;
}

.side-menu .nav-links a:hover {
    color: var(--primary);
}

.lang-section {
    border-bottom: 1px solid #444;
    padding-bottom: 1rem;
}

.lang-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    color: #aaa;
    margin-bottom: 0.5rem;
}

.flags {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
}

.flag-link {
    font-size: 1.2rem;
    opacity: 0.7;
}

.flag-link:hover {
    opacity: 1;
}

.footer-links {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid #444;
    font-size: 0.8rem;
}

.footer-links a {
    display: block;
    color: #aaa;
    padding: 0.3rem 0;
}

.footer-links a:hover {
    color: var(--primary);
}

.dark-mode-toggle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid #444;
}

.toggle-switch {
    width: 50px;
    height: 24px;
    background: #333;
    border-radius: 30px;
    position: relative;
    cursor: pointer;
}

.toggle-switch:after {
    content: "🌙";
    position: absolute;
    width: 20px;
    height: 20px;
    background: white;
    border-radius: 50%;
    top: 2px;
    left: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    transition: 0.2s;
}

body.dark .toggle-switch:after {
    content: "☀️";
    left: 26px;
}

/* ===================== */
/* HERO - ŞEFFAF */
/* ===================== */
.hero {
    position: relative;
    background: rgba(10, 10, 10, 0.7);
    backdrop-filter: blur(2px);
    padding: 4rem 2rem;
    text-align: center;
    color: #ffffff;
    overflow: hidden;
    border-radius: var(--border-radius);
    margin: 1rem;
}

.hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: var(--hero-pattern, none);
    background-size: cover;
    opacity: 0.3;
    z-index: 0;
    pointer-events: none;
}

.hero > * {
    position: relative;
    z-index: 1;
}

.hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #ffffff 0%, var(--primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-description {
    font-size: 1.2rem;
    opacity: 0.85;
    max-width: 600px;
    margin: 0 auto 1.5rem;
}

.hero-cta {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 2rem;
    font-weight: 600;
    margin: 0.25rem;
}

.hero-cta-primary {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: #0a0a0a;
    box-shadow: 0 4px 12px rgba(46, 204, 113, 0.3);
}

.hero-cta-primary:hover {
    transform: translateY(-2px);
}

.hero-cta-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
}

.hero-cta-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
}

/* ===================== */
/* FEATURED ARTICLE */
/* ===================== */
.featured {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 1.5rem;
}

.featured-card {
    display: flex;
    gap: 2rem;
    background: var(--white);
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: var(--transition);
}

.featured-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
}

.featured-card img {
    width: 50%;
    object-fit: cover;
}

.featured-content {
    padding: 2rem;
    flex: 1;
}

.featured-content h2 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
}

.featured-meta {
    color: var(--text-light);
    font-size: 0.9rem;
    margin: 0.5rem 0;
    display: flex;
    gap: 1rem;
}

/* ===================== */
/* ARTICLE GRID */
/* ===================== */
.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
}

.section-title {
    font-size: 1.8rem;
    margin-bottom: 2rem;
    font-weight: 700;
}

.article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
}

.article-card {
    background: var(--white);
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: var(--transition);
    display: block;
}

.article-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
}

.article-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.article-card h3 {
    padding: 1rem 1rem 0.5rem;
    font-size: 1.2rem;
}

.article-meta {
    padding: 0 1rem;
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--text-light);
}

.article-card p {
    padding: 0.5rem 1rem 1rem;
    color: var(--text-light);
    font-size: 0.9rem;
}

/* ===================== */
/* SINGLE ARTICLE */
/* ===================== */
.breadcrumb {
    font-size: 0.85rem;
    color: var(--text-light);
    margin: 1rem auto;
    max-width: 720px;
    padding: 0 1rem;
}

.breadcrumb a {
    color: var(--primary);
}

.hero-image {
    width: 70%;
    max-width: 700px;
    border-radius: var(--border-radius);
    margin: 0 auto 2rem auto;
    display: block;
    aspect-ratio: 16/9;
    object-fit: cover;
}

.content-image-1 {
    width: 60%;
    max-width: 600px;
    border-radius: 0.75rem;
    margin: 1.5rem auto;
    display: block;
}

.content-image-2 {
    width: 40%;
    max-width: 400px;
    border-radius: 0.75rem;
    margin: 1rem 0 1rem 1.5rem;
    float: right;
}

.meta-info {
    color: var(--text-light);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

.summary {
    background: var(--gray);
    padding: 1.5rem;
    border-radius: var(--border-radius);
    margin: 1.5rem 0;
    border-left: 4px solid var(--primary);
}

.summary-title {
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 0.5rem;
}

.summary-list {
    list-style: none;
}

.summary-list li {
    padding: 0.3rem 0;
}

.article-content {
    font-size: 1.1rem;
    overflow: auto;
}

.article-content h2 {
    margin-top: 1.5rem;
    margin-bottom: 1rem;
}

.article-content h3 {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
}

.editors-note {
    background: #f0f7f0;
    border-left: 4px solid var(--primary);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    font-size: 0.95rem;
    border-radius: 0 0.75rem 0.75rem 0;
}

.editors-note::before {
    content: "✍️ Editor's Note: ";
    font-weight: 700;
    font-style: normal;
    color: var(--primary);
}

.editors-note-rounded {
    background: #f0f7f0;
    border-left: 4px solid var(--primary);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
    font-size: 0.95rem;
    border-radius: 1rem;
}

.editors-note-rounded::before {
    content: "✍️ Editor's Note: ";
    font-weight: 700;
    font-style: normal;
    color: var(--primary);
}

.sources {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid #ddd;
}

.sources-list {
    list-style: none;
    padding-left: 0;
}

.sources-list li {
    margin-bottom: 0.5rem;
}

/* ===================== */
/* READ NEXT */
/* ===================== */
.read-next {
    margin-top: 2rem;
}

.read-next-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
}

.read-next-card {
    background: var(--white);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: var(--shadow);
}

.read-next-card:hover {
    transform: translateY(-3px);
}

.read-next-card img {
    width: 100%;
    height: 140px;
    object-fit: cover;
}

.read-next-card h4 {
    padding: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
}

.random-article {
    text-align: center;
    margin: 1.5rem 0;
}

.category-archive {
    text-align: center;
    margin: 2rem 0;
}

.adsense-wrapper {
    text-align: center;
    margin: 2rem 0;
    min-height: 90px;
}

.image-wrapper {
    text-align: center;
    margin: 1.5rem 0;
}

/* ===================== */
/* STATIC PAGES */
/* ===================== */
.page-container {
    max-width: 800px;
    margin: 60px auto;
    padding: 0 20px;
}

.page-container h1 {
    font-size: 48px;
    font-weight: 900;
    letter-spacing: -2px;
    margin-bottom: 30px;
    border-left: 10px solid var(--primary);
    padding-left: 20px;
}

.page-container h2 {
    margin-top: 40px;
    border-left: 5px solid var(--primary);
    padding-left: 15px;
}

.page-container p {
    font-size: 18px;
    margin-bottom: 25px;
    line-height: 1.8;
}

.page-container ul, .page-container ol {
    margin: 20px 0;
    padding-left: 30px;
}

.mission-box, .contact-box, .note-box {
    background: var(--gray);
    padding: 30px;
    border: 1px solid #ddd;
    margin: 30px 0;
    border-radius: var(--border-radius);
}

.mission-box h3, .contact-box h3, .note-box h3 {
    margin-bottom: 15px;
    color: var(--primary-dark);
}

.note-box {
    border-left: 4px solid var(--primary);
    background: #f0f7f0;
}

/* ===================== */
/* TOGGLE BİLEŞENİ */
/* ===================== */
.toggle-details {
    margin: 1rem 0;
    border-radius: 1rem;
    background: var(--white);
    box-shadow: var(--shadow);
    border: 1px solid rgba(0,0,0,0.05);
}

.toggle-details summary {
    padding: 1rem 1.5rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    border-radius: 1rem;
}

.toggle-details summary:hover {
    background: rgba(0,0,0,0.03);
}

.toggle-details summary::-webkit-details-marker {
    display: none;
}

.toggle-title {
    font-weight: 700;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.toggle-icon {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--primary);
    transition: transform 0.3s ease;
}

.toggle-details[open] .toggle-icon {
    transform: rotate(180deg);
}

.toggle-content-inner {
    padding: 0 1.5rem 1.5rem 1.5rem;
    border-top: 1px solid rgba(0,0,0,0.05);
}

.takeaways-preview {
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    color: var(--text-light);
    font-size: 0.85rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.author-bio-compact {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1rem;
}

.author-avatar-compact {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
}

.author-info-compact h4 {
    margin: 0;
    font-size: 1rem;
}

.author-info-compact p {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    color: var(--text-light);
}

.author-bio-full {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-light);
}

/* ===================== */
/* FOOTER */
/* ===================== */
footer {
    background: var(--dark);
    color: white;
    padding: 3rem 5%;
    margin-top: 3rem;
}

.footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
}

.footer-column h4 {
    margin-bottom: 1rem;
    font-size: 1rem;
}

.footer-column a {
    display: block;
    color: #aaa;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
}

.footer-column a:hover {
    color: var(--primary);
}

.footer-copyright {
    text-align: center;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #444;
    font-size: 0.8rem;
    color: #aaa;
}

/* ===================== */
/* DARK MODE */
/* ===================== */
body.dark {
    background: #121212;
    color: #e0e0e0;
}

body.dark nav {
    background: rgba(18, 18, 18, 0.98);
    border-bottom-color: #333;
}

body.dark .logo,
body.dark .nav-links a {
    color: #e0e0e0;
}

body.dark .article-card,
body.dark .featured-card,
body.dark .read-next-card,
body.dark .toggle-details {
    background: #1e1e1e;
}

body.dark .footer-links a,
body.dark .footer-column a {
    color: #aaa;
}

body.dark .summary,
body.dark .mission-box,
body.dark .contact-box,
body.dark .note-box {
    background: #2a2a2a;
    border-color: #333;
}

body.dark .editors-note,
body.dark .editors-note-rounded {
    background: #1e3a2a;
}

body.dark .article-content {
    color: #d0d0d0;
}

body.dark .meta-info,
body.dark .breadcrumb {
    color: #888;
}

body.dark .sources {
    border-top-color: #444;
}

body.dark footer {
    background: #0a0a0a;
}

body.dark .hero {
    background: rgba(0, 0, 0, 0.7);
}

body.dark .hero-title {
    background: linear-gradient(135deg, #ffffff 0%, var(--primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* ===================== */
/* RESPONSIVE */
/* ===================== */
@media (max-width: 768px) {
    .nav-links {
        display: none;
    }
    .menu-btn {
        display: block;
    }
    .article-grid {
        grid-template-columns: 1fr;
    }
    .featured-card {
        flex-direction: column;
    }
    .featured-card img {
        width: 100%;
        height: 200px;
    }
    .featured-content {
        padding: 1.5rem;
    }
    .featured-content h2 {
        font-size: 1.4rem;
    }
    .footer-content {
        grid-template-columns: 1fr;
        text-align: center;
    }
    .hero {
        padding: 2rem 1rem;
        margin: 0.5rem;
    }
    .hero-title {
        font-size: clamp(1.5rem, 6vw, 2rem);
    }
    .hero-description {
        font-size: 1rem;
    }
    h1 {
        font-size: 1.8rem;
    }
    .page-container h1 {
        font-size: 32px;
    }
    .hero-image,
    .content-image-1,
    .content-image-2 {
        width: 100%;
        float: none;
        margin: 1rem 0;
    }
}

@media (min-width: 769px) and (max-width: 1024px) {
    .article-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .hero-image {
        width: 85%;
    }
    .content-image-1 {
        width: 75%;
    }
    .content-image-2 {
        width: 50%;
    }
}

/* ===================== */
/* ANIMATIONS */
/* ===================== */
@keyframes heroFadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.hero > * {
    animation: heroFadeIn 0.5s ease forwards;
}

.hero > *:nth-child(1) { animation-delay: 0.05s; }
.hero > *:nth-child(2) { animation-delay: 0.1s; }
.hero > *:nth-child(3) { animation-delay: 0.15s; }
.hero > *:nth-child(4) { animation-delay: 0.2s; }
.hero > *:nth-child(5) { animation-delay: 0.25s; }
.hero > *:nth-child(6) { animation-delay: 0.3s; }

