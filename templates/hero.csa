/* Hero Container */
.hero {
    padding: 3rem 1.5rem;
    text-align: center;
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
    color: white;
    position: relative;
    overflow: hidden;
}

/* Title & Description */
.hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
}

.hero-description {
    font-size: 1.2rem;
    opacity: 0.8;
    max-width: 600px;
    margin: 0 auto 1.5rem;
}

/* CTA Buttons */
.hero-cta {
    display: inline-block;
    background: var(--primary);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 2rem;
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.3s;
}

.hero-cta:hover {
    opacity: 0.9;
}

/* Featured Articles Section */
.hero-featured-section {
    margin: 2rem 0;
}

.hero-featured-title {
    font-size: 1.2rem;
    margin-bottom: 1rem;
    color: var(--primary);
}

.hero-featured-articles {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

.featured-article-item {
    background: rgba(255,255,255,0.1);
    border-radius: 0.75rem;
    overflow: hidden;
    width: 200px;
    transition: transform 0.3s;
}

.featured-article-item:hover {
    transform: translateY(-5px);
}

.featured-article-item img {
    width: 100%;
    height: 120px;
    object-fit: cover;
}

.featured-article-item a {
    text-decoration: none;
    color: white;
}

.featured-article-title {
    display: block;
    padding: 0.75rem 0.75rem 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
}

.featured-article-meta {
    display: block;
    padding: 0 0.75rem 0.75rem;
    font-size: 0.7rem;
    opacity: 0.6;
}

/* News Ticker */
.hero-news-ticker {
    background: rgba(46,204,113,0.15);
    border-radius: 2rem;
    padding: 0.5rem 1rem;
    margin: 1.5rem auto;
    display: inline-block;
    overflow: hidden;
    max-width: 100%;
}

.ticker-wrapper {
    overflow: hidden;
}

.ticker {
    display: inline-block;
    white-space: nowrap;
    animation: ticker-scroll 25s linear infinite;
}

.ticker-item {
    display: inline-block;
    margin-right: 2rem;
    font-size: 0.85rem;
}

.ticker-item::before {
    content: "🔥";
    margin-right: 0.5rem;
}

@keyframes ticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

/* YouTube Video */
.hero-youtube {
    max-width: 560px;
    margin: 1.5rem auto;
}

.hero-youtube iframe {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 1rem;
}

.hero-youtube-caption {
    font-size: 0.8rem;
    opacity: 0.7;
    margin-top: 0.5rem;
}

/* GIF & Image */
.hero-gif-wrapper,
.hero-image-wrapper {
    margin: 1.5rem auto;
}

.hero-gif,
.hero-image {
    max-width: 100%;
    border-radius: 1rem;
}

/* Stats */
.hero-stats {
    display: flex;
    gap: 2rem;
    justify-content: center;
    margin: 1.5rem 0;
    flex-wrap: wrap;
}

.stat {
    text-align: center;
}

.stat-value {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--primary);
}

.stat-label {
    font-size: 0.8rem;
    opacity: 0.7;
}

/* Carousel */
.hero-carousel {
    position: relative;
    max-width: 800px;
    margin: 1.5rem auto;
    overflow: hidden;
    border-radius: 1rem;
}

.carousel-container {
    position: relative;
    aspect-ratio: 16/9;
}

.carousel-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease;
}

.carousel-slide.active {
    opacity: 1;
}

.carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.carousel-prev,
.carousel-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0,0,0,0.5);
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    cursor: pointer;
    border-radius: 0.5rem;
    z-index: 10;
}

.carousel-prev { left: 1rem; }
.carousel-next { right: 1rem; }

.carousel-dots {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 10;
}

.dot {
    width: 10px;
    height: 10px;
    background: rgba(255,255,255,0.5);
    border-radius: 50%;
    cursor: pointer;
}

.dot.active {
    background: var(--primary);
}

/* Countdown */
.hero-countdown {
    text-align: center;
    margin: 1.5rem 0;
}

.countdown-timer {
    font-size: 2rem;
    font-weight: 700;
    font-family: monospace;
    letter-spacing: 0.1em;
}

/* Quote */
.hero-quote {
    max-width: 600px;
    margin: 1.5rem auto;
    padding: 1rem;
    border-left: 4px solid var(--primary);
    text-align: left;
}

.hero-quote blockquote {
    font-size: 1.1rem;
    font-style: italic;
    margin-bottom: 0.5rem;
}

.hero-quote cite {
    font-size: 0.8rem;
    opacity: 0.7;
}

/* Responsive */
@media (max-width: 768px) {
    .hero {
        padding: 2rem 1rem;
    }
    
    .hero-featured-articles {
        flex-direction: column;
        align-items: center;
    }
    
    .featured-article-item {
        width: 100%;
        max-width: 280px;
    }
    
    .hero-stats {
        gap: 1rem;
    }
    
    .stat-value {
        font-size: 1.5rem;
    }
}
